# Build context for the serving image.
# NOTE: models/ is deliberately NOT ignored - the image must ship the
# trained artifact (models/model.joblib) and its metadata sidecar, otherwise
# the API starts in "degraded" state and /predict returns 503.

# --- VCS and local environments ----------------------------------------
.git/
.github/
.venv/
venv/

# --- Python build/test junk --------------------------------------------
**/__pycache__/
**/*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- Training-only assets (never read while serving) --------------------
data/
mlruns/
mlflow.db

# --- Tests, docs and local tooling -------------------------------------
tests/
docs/
*.md
!README.md
Makefile
docker-compose.yml
